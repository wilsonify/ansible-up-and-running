Vagrant.configure(2) do |config|
  config.vm.box = "ubuntu/focal64"
  config.vm.hostname = "testserver"

  config.vm.network "forwarded_port",
    id: 'ssh', guest: 22, host: 2202, host_ip: "127.0.0.1", auto_correct: false
  config.vm.network "forwarded_port",
    id: 'http', guest: 80, host: 8080, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port",
    id: 'https', guest: 443, host: 8443, host_ip: "127.0.0.1"

  # disable updating guest additions
  if Vagrant.has_plugin?("vagrant-vbguest")
    config.vbguest.auto_update = false
  end

  config.vm.provider "virtualbox" do |virtualbox|
    virtualbox.name = "ch03"
  end

  # Provisioner: set up daily cron for Ansible playbook
  config.vm.provision "shell", inline: <<-SHELL
    # Install cron if not present
    sudo apt-get update
    sudo apt-get install -y cron ansible

    # Add cron job for daily playbook run at 2am
    CRON_JOB="0 2 * * * ansible-playbook /vagrant/playbooks/webservers.yml >> /home/vagrant/playbook.log 2>&1"
    (crontab -l 2>/dev/null | grep -v -F "$CRON_JOB" ; echo "$CRON_JOB") | crontab -

    # Ensure cron service is running
    sudo systemctl enable cron
    sudo systemctl restart cron
  SHELL
end
